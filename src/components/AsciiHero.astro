---
// Renders one torus frame at build time so no-JS visitors, crawlers and
// reduced-motion users get a complete static image with zero layout shift.
// The inline script below carries its own copy of this math — keep in sync.
const W = 80;
const H = 22;

function renderFrame(A: number, B: number): string {
  const ramp = '.,-~:;=!*#$@';
  const buf: string[] = new Array(W * H).fill(' ');
  const zbuf: number[] = new Array(W * H).fill(0);
  const cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
  for (let j = 0; j < 6.28; j += 0.07) {
    const ct = Math.cos(j), st = Math.sin(j), h = ct + 2;
    for (let i = 0; i < 6.28; i += 0.02) {
      const sp = Math.sin(i), cp = Math.cos(i);
      const D = 1 / (sp * h * sA + st * cA + 5);
      const t = sp * h * cA - st * sA;
      const x = (W / 2 + 30 * D * (cp * h * cB - t * sB)) | 0;
      const y = (H / 2 + 15 * D * (cp * h * sB + t * cB)) | 0;
      const o = x + W * y;
      const N = (8 * ((st * sA - sp * ct * cA) * cB - sp * ct * sA - st * cA - cp * ct * sB)) | 0;
      if (y >= 0 && y < H && x >= 0 && x < W && D > zbuf[o]) {
        zbuf[o] = D;
        buf[o] = ramp[N > 0 ? Math.min(N, 11) : 0];
      }
    }
  }
  const rows: string[] = [];
  for (let r = 0; r < H; r++) rows.push(buf.slice(r * W, r * W + W).join(''));
  return rows.join('\n');
}

const staticFrame = renderFrame(0.35, 0.2);
---
<div class="hero-art">
  <pre id="donut" aria-hidden="true">{staticFrame}</pre>
</div>
<script is:inline>
(() => {
  const el = document.getElementById('donut');
  if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const W = 80, H = 22, ramp = '.,-~:;=!*#$@';
  const render = (A, B) => {
    const buf = new Array(W * H).fill(' ');
    const zbuf = new Array(W * H).fill(0);
    const cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
    for (let j = 0; j < 6.28; j += 0.07) {
      const ct = Math.cos(j), st = Math.sin(j), h = ct + 2;
      for (let i = 0; i < 6.28; i += 0.02) {
        const sp = Math.sin(i), cp = Math.cos(i);
        const D = 1 / (sp * h * sA + st * cA + 5);
        const t = sp * h * cA - st * sA;
        const x = (W / 2 + 30 * D * (cp * h * cB - t * sB)) | 0;
        const y = (H / 2 + 15 * D * (cp * h * sB + t * cB)) | 0;
        const o = x + W * y;
        const N = (8 * ((st * sA - sp * ct * cA) * cB - sp * ct * sA - st * cA - cp * ct * sB)) | 0;
        if (y >= 0 && y < H && x >= 0 && x < W && D > zbuf[o]) {
          zbuf[o] = D;
          buf[o] = ramp[N > 0 ? Math.min(N, 11) : 0];
        }
      }
    }
    let s = '';
    for (let r = 0; r < H; r++) s += buf.slice(r * W, r * W + W).join('') + (r < H - 1 ? '\n' : '');
    return s;
  };
  let A = 0.35, B = 0.2, tx = 0, ty = 0, ox = 0, oy = 0, last = 0;
  addEventListener('pointermove', (e) => {
    tx = (e.clientX / innerWidth - 0.5) * 1.4;
    ty = (e.clientY / innerHeight - 0.5) * 1.4;
  }, { passive: true });
  const tick = (t) => {
    requestAnimationFrame(tick);
    if (t - last < 33) return;
    last = t;
    A += 0.035;
    B += 0.017;
    ox += (tx - ox) * 0.06;
    oy += (ty - oy) * 0.06;
    el.textContent = render(A + oy, B + ox);
  };
  requestAnimationFrame(tick);
})();
</script>
